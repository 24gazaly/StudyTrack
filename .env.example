# StudyTrack (Next.js) — salin ke `.env` dan isi nilainya.
# Database: Supabase Postgres via Pooler (IPv4, ramah Vercel Serverless).
# Contoh pooler: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Koneksi langsung (untuk `prisma migrate`, IPv6 OK dari lokal):
DIRECT_URL="postgresql://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres"

# Auth.js — generate dengan: npx auth secret
AUTH_SECRET="ganti-dengan-secret-minimal-32-karakter"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Opsional: URL publik aplikasi (dipakai metadata/sitemap)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
